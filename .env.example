# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# PostgreSQL connection string.
DATABASE_URL="postgresql://dumb:dumb@localhost:5432/dumb?schema=public"

# HS256 signing key for session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-random-string-of-at-least-32-chars"

# Public origin used for canonical URLs, sitemap and OG images.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Local dev: public/uploads (served by Next). Production: /data/uploads (volume).
UPLOAD_DIR="public/uploads"
MAX_UPLOAD_BYTES=8388608

# ---------------------------------------------------------------------------
# AI (DeepSeek / any OpenAI-compatible endpoint) — optional
# ---------------------------------------------------------------------------
AI_BASE_URL="https://api.deepseek.com"
AI_API_KEY=""
AI_MODEL="deepseek-chat"

# ---------------------------------------------------------------------------
# Metadata providers — optional, admin AI features degrade gracefully
# ---------------------------------------------------------------------------
LASTFM_ENABLED=true
LASTFM_API_KEY=""
LASTFM_BASE_URL="https://ws.audioscrobbler.com/2.0/"
LASTFM_AUTOCORRECT=true

TMDB_API_KEY=""
TMDB_BASE_URL="https://api.themoviedb.org/3"
TMDB_IMAGE_BASE_URL="https://image.tmdb.org/t/p/original"

# ---------------------------------------------------------------------------
# Seed admin (used by prisma/seed.ts)
# ---------------------------------------------------------------------------
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="admin123"
SEED_ADMIN_EMAIL="admin@dumb.com"
